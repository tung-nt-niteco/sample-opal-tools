{
  "version": 2,
  "name": "tung-opal-test",
  "builds": [
	{ "src": "/public/**", "use": "@vercel/static" },
	{ "src": "src/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    {
      "src": "/",
      "dest": "/dist/index.js",
      "methods": ["GET"]
    },
    {
      "src": "/",
      "dest": "/dist/index.js",
      "methods": ["POST"]
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.js",
      "methods": ["GET"]
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.js",
      "methods": ["POST"]
    }
  ]
}
